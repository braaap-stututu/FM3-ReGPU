+    // through the PCIe BAR): a store that follows a burst of such writes waits for them to drain, ~6-13% of
+    // the draw thread in FM3. Here they go to this cached buffer instead. The pointer is valid until the next
+    // call on this list. Recorded right away into the ring on a direct list.
+    uint8_t* RingBytes(uint8_t* base, uint32_t offset, uint32_t n)
+    {
+        if (m_direct)
+            return base + offset;
+        // (A large group goes out on its own: earlier segments' bytes are written by now.)
+        if (m_current.size() >= kChunk + kRingChunk)
