+            m_ringGroup = m_current.size();
+            m_ringBase = base;
+            const uint32_t header[2] = { kRingWrite, 0 };
+            m_current.resize(m_ringGroup + sizeof(header) + sizeof(base));
+            memcpy(m_current.data() + m_ringGroup, header, sizeof(header));
+            memcpy(m_current.data() + m_ringGroup + sizeof(header), &base, sizeof(base));
+        }
