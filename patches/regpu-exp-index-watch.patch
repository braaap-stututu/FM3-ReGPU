@@ -4510,7 +4510,46 @@ bool GetIndexBuffer(uint32_t base, uint32_t count, bool is32, uint32_t endian, D
         return false;
     static LiveSwitch sampledIndexHash("REGPU_INDEX_SAMPLED_HASH");
     const uint8_t* src = GuestPtr<uint8_t>(GpuPhysToGuest(base));
-    const uint64_t hash = sampledIndexHash ? ContentHash(src, bytes) : FullHash(src, bytes);
+    // Experimental branch, session 46: an index buffer none of whose pages was written since it was last hashed keeps
+    // that hash (the vertex arena's write watch, Host::watchArm/watchClean). The full hash of every index buffer each
+    // frame was +2.9% of 2-core frozen-grid fps (REGPU_INDEX_SAMPLED_HASH as its ceiling). Serial draw thread only
+    // (the table is unlocked). REGPU_EXP_NO_INDEX_WATCH=1 (live): hashed every frame, as before (A/B);
+    // REGPU_EXP_INDEX_WATCH_VERIFY=1 (live): hashed anyway, a change the watch missed is logged (the first 20).
+    uint64_t hash;
+    const regpu::Host& host = regpu::GetHost();
+    static LiveSwitch noIndexWatch("REGPU_EXP_NO_INDEX_WATCH"), verifyIndexWatch("REGPU_EXP_INDEX_WATCH_VERIFY");
+    if (host.watchArm && host.watchClean && host.watchSeq && !C().worker && !RendererDrawWorkers() && !noIndexWatch && !sampledIndexHash)
+    {
+        struct Watched
+        {
+            uint64_t hash = 0, seq = 0;
+            bool watched = false;
+        };
+        static std::unordered_map<uint64_t, Watched> watchedIndices;
+        const uint32_t physical = base & 0x1FFFFFFF;
+        auto [it, inserted] = watchedIndices.try_emplace(uint64_t(physical) << 32 | bytes);
+        Watched& w = it->second;
+        if (!inserted && w.watched && host.watchClean(physical, bytes, w.seq))
+        {
+            hash = w.hash;
+            if (verifyIndexWatch)
+                if (const uint64_t now = FullHash(src, bytes); now != hash)
+                {
+                    static int missed = 0;
+                    if (missed++ < 20)
+                        Log("exp index watch: %08X (%u bytes) changed without a write seen", physical, bytes);
+                    hash = now;
+                }
+        }
+        else
+        {
+            w.seq = host.watchSeq() + 1; // (a write between now and the hash counts as after it)
+            w.watched = host.watchArm(physical, bytes); // before the hash: a write after it faults and is seen
+            hash = w.hash = FullHash(src, bytes);
+        }
+    }
+    else
+        hash = sampledIndexHash ? ContentHash(src, bytes) : FullHash(src, bytes);
     std::lock_guard textureLock(g_textureMutex);
     g_indexChanging = false;
     if (!GetIndexBufferLocked(base, count, is32, endian, view, hash))
