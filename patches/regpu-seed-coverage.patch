     g_lastFrameDraws.store(g_r.drawsThisFrame.load(), std::memory_order_relaxed);
     g_r.drawsThisFrame = g_r.skippedThisFrame = 0;
     g_r.frameIndex = (g_r.frameIndex + 1) % kFrames;
