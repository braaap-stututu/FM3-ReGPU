+bool StereoFrame(float& clipPerMetre, float& halfIpd)
+{
+    if (!StereoMode())
+        return false;
+    // REGPU_VR_STEREO_TEST=1 (live): stereo without a headset, for screenshots (the desktop shows the eye drawn second;
