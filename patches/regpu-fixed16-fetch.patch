+        // copy's integers as floats (see the resolve: the exponent bias applied, saturated to 16 bits by the
+        // copy's number format). On the console a fetch reads those 16 bits with the fetch constant's own
+        // number format (dword 3 bit 0: integer) and sign (dword 0 bits 2-3: 1 signed): an unsigned fraction
+        // is bits / 65535 (a negative integer's bits are value + 65536), a signed one value / 32767, an
+        // integer the value itself. Unconverted, a fraction fetch read values up to 65535 times too large
+        // (FM3's variance shadow map, resolved as signed integers and fetched as unsigned fractions: the
+        // road shader's shadow test banded into streaks). tinfo.x bits 14-15 (mode) and 2-3 (components),
+        // applied before the exponent adjust (hlsl.cpp Fixed16Fetch). REGPU_NO_FIXED16_FETCH=1: unconverted
+        // (A/B; read with the fetch constant, so set it before the start).
+        static const bool noFixed16Fetch = getenv("REGPU_NO_FIXED16_FETCH") != nullptr;
+        if (onGpu && resolvedPtr && resolvedPtr->guestFormat >= 24 && resolvedPtr->guestFormat <= 26 && !noFixed16Fetch)
+        {
+            const bool isSigned = ((fetch.dwords[0] >> 2) & 3) == 1;
+            const bool integer = (fetch.dwords[3] & 1) != 0;
+            const uint32_t mode = integer ? (isSigned ? 0u : 3u) : (isSigned ? 2u : 1u);
+            const uint32_t comps = resolvedPtr->guestFormat == 24 ? 0u : resolvedPtr->guestFormat == 25 ? 1u : 2u;
+            ti[0] |= (mode << 14) | (comps << 2);
+        }
