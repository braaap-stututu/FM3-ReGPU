+// A resolved 16-bit fixed image (tinfo.x bits 14-15 mode, bits 2-3 components: 0 one, 1 two, 2 four) holds
+// the copy's integers as floats; the fetch reads those 16 bits with its own number format and sign
+// (renderer.cpp): 1 unsigned fraction (bits / 65535), 2 signed fraction (value / 32767), 3 unsigned integer.
+float4 Fixed16Fetch(float4 v, uint info)
+{
+    const uint mode = (info >> 14) & 3u;
+    if (mode == 0u)
+        return v;
+    // Vector selects, no loop: fxc can't unroll a loop that writes v[c] (error X3500 / X3511).
+    const uint comps = 1u << ((info >> 2) & 3u);
+    const float4 bits = v + (v < 0.0 ? 65536.0 : 0.0);
+    const float4 r = mode == 1u ? bits / 65535.0 : (mode == 2u ? max(v / 32767.0, -1.0) : bits);
+    const bool4 use = bool4(true, comps >= 2u, comps >= 4u, comps >= 4u);
+    return use ? r : v;
+}
