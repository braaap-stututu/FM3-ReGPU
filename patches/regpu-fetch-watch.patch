+
+void regpu::SetFetchWatch(bool on, uint32_t slot, uint32_t bytes, const uint32_t constants[6])
+{
+    std::lock_guard lock(g_watchMutex);
+    g_watchSlot = slot, g_watchBytes = bytes;
+    for (int c = 0; c < 6; c++)
+        g_watchConst[c] = constants ? constants[c] : 0;
+    g_watchHits.clear();
+    g_watchSeen.clear();
+    g_watchOn = on;
+}
+
+void regpu::SetFetchWatchAux(uint32_t slot)
+{
+    std::lock_guard lock(g_watchMutex);
+    g_watchAux = slot;
+}
+
+size_t regpu::TakeFetchWatch(FetchWatchHit* out, size_t max)
+{
+    std::lock_guard lock(g_watchMutex);
+    const size_t n = std::min(max, g_watchHits.size());
+    for (size_t i = 0; i < n; i++)
+        out[i] = g_watchHits[i];
+    g_watchHits.clear();
+    g_watchSeen.clear();
+    return n;
+}
