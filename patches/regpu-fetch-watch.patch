+// regpu::SetFetchWatch (2026-11-27, for the FM3 port's Godot renderer: which car's damage table is which): while on,
+// each draw whose vertex shader reads vertex fetch constant `slot` with a buffer of `bytes` appends its address and
+// six float4 constants (the slots given) to a list the host drains with regpu::TakeFetchWatch (each address once a frame,
+// with the frame's number and the address in a second fetch constant, regpu::SetFetchWatchAux).
+namespace
+{
+std::mutex g_watchMutex;
+bool g_watchOn = false;
+uint32_t g_watchSlot = 0, g_watchBytes = 0;
+uint32_t g_watchConst[6] = {};
+std::vector<regpu::FetchWatchHit> g_watchHits;
+std::unordered_set<uint64_t> g_watchSeen;
+std::atomic<uint64_t> g_watchFrame{ 0 }; // (frames ended: RendererOnSwapImpl)
+uint32_t g_watchAux = 0xFFFFFFFFu; // (a second fetch constant whose address each hit carries, regpu::SetFetchWatchAux)
+}
+
+void FetchWatchDraw(const CompiledShader& vs)
+{
+    if (!g_watchOn)
+        return;
+    bool reads = false;
+    for (uint32_t k : vs.info.vertexFetchConstants)
+        reads = reads || k == g_watchSlot;
+    if (!reads)
+        return;
+    const uint32_t d0 = gpureg::Get(gpureg::FetchConstants + g_watchSlot * 2), d1 = gpureg::Get(gpureg::FetchConstants + g_watchSlot * 2 + 1);
+    const uint32_t size = ((d1 >> 2) & 0xFFFFFF) * 4;
+    if (g_watchBytes && size != g_watchBytes)
+        return;
+    regpu::FetchWatchHit h{};
+    h.address = d0 & 0xFFFFFFFC;
+    h.bytes = size;
+    h.frame = uint32_t(g_watchFrame.load(std::memory_order_relaxed));
+    h.aux = g_watchAux < 96 ? gpureg::Get(gpureg::FetchConstants + g_watchAux * 2) & 0xFFFFFFFC : 0;
+    for (int c = 0; c < 6; c++)
+        for (int j = 0; j < 4; j++)
+        {
+            const uint32_t bits = gpureg::Get(gpureg::AluConstants + g_watchConst[c] * 4 + j);
+            memcpy(&h.constants[c][j], &bits, 4);
+        }
+    std::lock_guard lock(g_watchMutex);
+    if (!g_watchSeen.insert((uint64_t(h.frame) << 32) | h.address).second)
+        return; // (each buffer once a frame: e.g. a car draws its damage table for many parts)
+    if (g_watchHits.size() < 65536)
+        g_watchHits.push_back(h);
+}
