<Project Sdk="Microsoft.NET.Sdk">

  <!-- The FM3 launcher, ported from the FM4 ReGPU launcher (braaap-stututu/Fuzzy-Rittersport-4-ReGPU-testing,
       launcher/FM4Launcher): a Photino window showing wwwroot (the UI) on WebView2. The page talks to Bridge.cs over
       the window's message channel (no local server). Build: dotnet build -c Release, or dotnet publish -r win-x64. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FM3Launcher</AssemblyName>
    <RootNamespace>FM3Launcher</RootNamespace>
    <Product>Forza Motorsport 3 ReGPU</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\fm3.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The release version, from the repo's VERSION file unless the build passes -p:Version (installer\build-*.ps1).
         Shown in the launcher's header. -->
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window icon (Window.cs): fm3.ico on Windows, icon.png on Linux (also the desktop entry's). -->
    <Content Include="..\..\assets\fm3.ico" Link="fm3.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\icon.png" Link="wwwroot\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
